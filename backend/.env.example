# Flask
FLASK_ENV=production
SECRET_KEY=change-this-to-a-random-secret-key

# Database (для локальной разработки на Windows)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/standards_db

# JWT
JWT_SECRET_KEY=change-this-to-a-different-random-key

# File storage (path on QNAP where documents are stored)
UPLOAD_FOLDER=/app/uploads/documents

# Price per page in sum
PRICE_PER_PAGE=1000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ====== Payment System Credentials ======

# Click payment credentials
# Get these from Click merchant dashboard: https://my.click.uz/
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SERVICE_ID=your_click_service_id
CLICK_SECRET_KEY=your_click_secret_key

# PayMe payment credentials
# Get these from PayMe merchant dashboard: https://checkout.paycom.uz/
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key

# Card payment credentials (Uzcard/Humo via aggregator)
# Choose an aggregator: Apelsin, Payze, Octo, etc.
CARD_MERCHANT_ID=your_card_merchant_id
CARD_SECRET_KEY=your_card_secret_key
CARD_API_URL=https://api.your-aggregator.uz

# ====== AI Assistant Configuration ======
# URL Django AI backend (запускается отдельно на порту 8000)
AI_BACKEND_URL=http://localhost:8000
