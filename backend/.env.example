# Server Configuration
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://yoursite.uz

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=standards_db
DB_USER=standards_user
DB_PASSWORD=CHANGE_THIS_PASSWORD

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_PASSWORD

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_VERY_LONG_RANDOM_STRING_AT_LEAST_32_CHARACTERS
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Payment Systems
# Click
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SECRET_KEY=your_click_secret_key
CLICK_SERVICE_ID=your_click_service_id

# PayMe
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_PATH=/app/uploads
ALLOWED_FILE_TYPES=pdf,doc,docx

# Email Configuration (для уведомлений)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=noreply@yoursite.uz
