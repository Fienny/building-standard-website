# Flask
FLASK_ENV=production
SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URL=postgresql://standards_user:change_this_password@postgres:5432/standards_db

# JWT
JWT_SECRET_KEY=change-this-to-a-different-random-key

# File storage (path on QNAP where documents are stored)
UPLOAD_FOLDER=/app/uploads/documents

# Price per page in sum
PRICE_PER_PAGE=1000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
