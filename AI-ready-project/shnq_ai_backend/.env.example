# DeepSeek API Configuration
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek Models (OpenAI-compatible)
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_EMBED_MODEL=text-embedding-3-small

# Timeouts (seconds)
DEEPSEEK_CHAT_TIMEOUT=45
DEEPSEEK_EMBED_TIMEOUT=12
DEEPSEEK_TRANSLATE_TIMEOUT=30

# Token limits
DEEPSEEK_TRANSLATE_MAX_TOKENS=320
DEEPSEEK_BATCH_TRANSLATE_MAX_TOKENS=900

# Features
DEEPSEEK_FAST_LANGUAGE_DETECT=1
DEEPSEEK_EMBED_FALLBACK=semantic_hash
DEEPSEEK_EMBED_STRICT=0

# Alternative: Use OpenAI instead of DeepSeek
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
