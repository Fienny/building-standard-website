# Docker Compose Environment Variables
# Скопируйте этот файл в .env и заполните своими данными

# PostgreSQL
DB_PASSWORD=your_secure_password_here

# Flask Backend
SECRET_KEY=your-super-secret-key-change-this
JWT_SECRET_KEY=another-super-secret-jwt-key
FRONTEND_URL=http://localhost

# Wasabi S3 Storage
# Получите ключи на https://wasabi.com/
WASABI_ACCESS_KEY_ID=your-wasabi-access-key-id
WASABI_SECRET_ACCESS_KEY=your-wasabi-secret-access-key
WASABI_BUCKET_NAME=standards
WASABI_REGION=eu-central-1

# DeepSeek AI (для AI-помощника)
# Получите ключ на https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
